# ── 运行时数据目录 ──
# 本地开发: runtime ; 容器: /data (持久卷)
FORECAST_LAB_RUNTIME_DIR=runtime

# ── 数据库连接串 (SQLAlchemy URL) ──
# - MySQL(生产/团队共用): mysql+pymysql://USER:PASS@HOST:PORT/DB?charset=utf8mb4
# - 不设此变量时默认 sqlite:///<runtime>/app.db (本地开发兜底)
DATABASE_URL=mysql+pymysql://forecast:CHANGE_ME@rds-xxx.intra.xiaojukeji.com:3306/forecast_lab?charset=utf8mb4

# 同时运行的训练任务上限(容器级), 超过会拒绝新提交
MAX_CONCURRENT_TRAINING=3

# ── 本地开发降级身份 (无 SSO 时用) ──
# 生产环境不要设置; 由 nginx 透传的 X-SSO-User 决定真实用户
FORECAST_LAB_DEV_USER=local-dev

# ── 公司 SSO（didi_sso）──
# 应用 ID/密钥在 SSO 管控台申请；生产环境不要关闭 SSO。
SSO_ENABLED=true
SSO_APP_ID=changeme
SSO_APP_KEY=changeme
SSO_HOST=https://mis.diditaxi.com.cn
# Upstream proxies may pass an internal Host; set this to the browser-facing URL.
PUBLIC_BASE_URL=https://forecast.intra.xiaojukeji.com
# 留空则 Cookie 限当前域；跨子域时填 .diditaxi.com.cn
SSO_DOMAIN=
SSO_LOGIN_PATH=/auth/sso/login
SSO_LOGOUT_PATH=/auth/ldap/logout
SSO_CHECK_TICKET_PATH=/auth/sso/api/check_ticket
SSO_CHECK_CODE_PATH=/auth/sso/api/check_code
SSO_USER_INDEX_PATH=/auth/api/user/index
UPM_CHECK_USER_TICKET_PATH=/auth/sso/api/get_user_by_ticket
SSO_MOCK=false

# MCP Gateway 鉴权（未接入 MCP 时可留空）
MCP_APP_ID=
MCP_SECRET_KEY=

# 本地开发可关闭 SSO，并提供默认身份。生产环境会忽略默认身份。
# APP_ENV=dev
# SSO_ENABLED=false
# SSO_DEFAULT_LDAP=zhangsan
# SSO_DEFAULT_USER_NAME=张三
