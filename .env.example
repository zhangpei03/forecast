# ── 运行时数据目录 ──
# 本地开发: runtime ; 容器: /data (持久卷)
FORECAST_LAB_RUNTIME_DIR=runtime

# ── 数据库连接串 (SQLAlchemy URL) ──
# - MySQL(生产/团队共用): mysql+pymysql://USER:PASS@HOST:PORT/DB?charset=utf8mb4
# - 不设此变量时默认 sqlite:///<runtime>/app.db (本地开发兜底)
DATABASE_URL=mysql+pymysql://forecast:CHANGE_ME@rds-xxx.intra.xiaojukeji.com:3306/forecast_lab?charset=utf8mb4

# 同时运行的训练任务上限(容器级), 超过会拒绝新提交
MAX_CONCURRENT_TRAINING=3

# ── 本地开发降级身份 (无 SSO 时用) ──
# 生产环境不要设置; 由 nginx 透传的 X-SSO-User 决定真实用户
FORECAST_LAB_DEV_USER=local-dev

# ── SSO (向 SSTG 申请 sso_upm_app_add_v3 工单后填入) ──
SSO_APP_ID=changeme
SSO_APP_KEY=changeme
# Fernet 密钥, 生成: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SSO_COOKIE_SECRET=changeme-fernet-key
SSO_COOKIE_NAME=fc_sso
SSO_LOGIN_URL=http://mis.diditaxi.com.cn/auth/sso/login
SSO_CHECK_CODE_URL=http://mis.diditaxi.com.cn/auth/sso/api/check_code
SSO_CHECK_TICKET_URL=http://mis.diditaxi.com.cn/auth/sso/api/check_ticket
SSO_LOGOUT_URL=http://mis.diditaxi.com.cn/auth/ldap/logout

# 本地/staging 联调用假身份打通 SSO 链路(不接真 SSO); 生产务必留空
# SSO_DEV_FAKE_USER=parkerzhang
