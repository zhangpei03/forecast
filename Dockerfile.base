FROM hub.xiaojukeji.com/parkerzhang/python:3.12-slim-bookworm
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_HTTP_TIMEOUT=600
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY vendor ./vendor
RUN pip install --no-cache-dir "uv>=0.5,<1" && uv sync --frozen --no-dev && rm -rf /app/.venv/lib/python3.12/site-packages/nvidia && rm -rf /root/.cache/uv
